<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:stewart_platform"
        x:Class="stewart_platform.MainWindow"
        Title="Stewart Platform V2 (Avalonia)" Height="700" Width="1150" Background="#F0F0F0">

	<Grid>
		<Grid ColumnDefinitions="400, *">

			<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10">
				<StackPanel Spacing="15">

					<Grid>
						<Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="15,20,15,15" Background="White">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Button x:Name="BtnConnect" Content="Connect Platform" Width="135" Click="BtnConnect_Click" Background="#2196F3" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
									<Button x:Name="BtnReset" Content="Reset Pose" Width="100" Click="BtnReset_Click" Background="#FFDDDD" Foreground="Black" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
								</StackPanel>
								<TextBlock x:Name="TxtStatus" Text="Disconnected" FontWeight="Bold" Foreground="Red" Margin="0,10,0,0"/>
							</StackPanel>
						</Border>
						<TextBlock Text="Hardware Connection" Background="#F0F0F0" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Foreground="Black"/>
					</Grid>

					<Grid>
						<Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="15,20,15,15" Background="White">
							<StackPanel Spacing="10">
								<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="60,*,60">
									<TextBlock Text="X Axis" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Black"/>
									<Slider x:Name="SldPosX" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="0" Grid.Column="1" Margin="10,0"/>
									<TextBox x:Name="InpPosX" Text="0.0" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>

									<TextBlock Text="Y Axis" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Black" Margin="0,10,0,0"/>
									<Slider x:Name="SldPosY" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="1" Grid.Column="1" Margin="10,10,10,0"/>
									<TextBox x:Name="InpPosY" Text="0.0" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Margin="0,10,0,0"/>

									<TextBlock Text="Z Axis" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="Black" Margin="0,10,0,0"/>
									<Slider x:Name="SldPosZ" Minimum="-50" Maximum="50" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="2" Grid.Column="1" Margin="10,10,10,0"/>
									<TextBox x:Name="InpPosZ" Text="0.0" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Margin="0,10,0,0"/>
								</Grid>
								<Button Content="Set Position" Click="BtnSetPos_Click" Width="120" HorizontalAlignment="Right" Margin="0,5,0,0" HorizontalContentAlignment="Center"/>
							</StackPanel>
						</Border>
						<TextBlock Text="Position (mm)" Background="#F0F0F0" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Foreground="Black"/>
					</Grid>

					<Grid>
						<Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="15,20,15,15" Background="White">
							<StackPanel Spacing="10">
								<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="60,*,60">
									<TextBlock Text="Roll (Rx)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Black"/>
									<Slider x:Name="SldRotX" Minimum="-30" Maximum="30" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="0" Grid.Column="1" Margin="10,0"/>
									<TextBox x:Name="InpRotX" Text="0.0" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>

									<TextBlock Text="Pitch (Ry)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Black" Margin="0,10,0,0"/>
									<Slider x:Name="SldRotY" Minimum="-30" Maximum="30" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="1" Grid.Column="1" Margin="10,10,10,0"/>
									<TextBox x:Name="InpRotY" Text="0.0" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Margin="0,10,0,0"/>

									<TextBlock Text="Yaw (Rz)" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="Black" Margin="0,10,0,0"/>
									<Slider x:Name="SldRotZ" Minimum="-30" Maximum="30" Value="0" ValueChanged="Slider_ValueChanged" Grid.Row="2" Grid.Column="1" Margin="10,10,10,0"/>
									<TextBox x:Name="InpRotZ" Text="0.0" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Margin="0,10,0,0"/>
								</Grid>
								<Button Content="Set Rotation" Click="BtnSetRot_Click" Width="120" HorizontalAlignment="Right" Margin="0,5,0,0" HorizontalContentAlignment="Center"/>
							</StackPanel>
						</Border>
						<TextBlock Text="Rotation (Degrees)" Background="#F0F0F0" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Foreground="Black"/>
					</Grid>

					<Grid>
						<Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="15,20,15,15" Background="White">
							<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
								<TextBlock x:Name="TxtServo0" Text="Servo 0: 0.00°" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" Foreground="Black"/>
								<TextBlock x:Name="TxtServo1" Text="Servo 1: 0.00°" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Foreground="Black"/>
								<TextBlock x:Name="TxtServo2" Text="Servo 2: 0.00°" Grid.Row="1" Grid.Column="0" Margin="0,0,0,10" Foreground="Black"/>
								<TextBlock x:Name="TxtServo3" Text="Servo 3: 0.00°" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Foreground="Black"/>
								<TextBlock x:Name="TxtServo4" Text="Servo 4: 0.00°" Grid.Row="2" Grid.Column="0" Foreground="Black"/>
								<TextBlock x:Name="TxtServo5" Text="Servo 5: 0.00°" Grid.Row="2" Grid.Column="1" Foreground="Black"/>
							</Grid>
						</Border>
						<TextBlock Text="Calculated Servo Angles" Background="#F0F0F0" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Foreground="Black"/>
					</Grid>

					<Grid>
						<Border BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="15,20,15,15" Background="#E3F2FD">
							<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
								<TextBlock x:Name="TxtSensorRoll" Text="Roll: 0.0°" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" Foreground="#0D47A1" FontWeight="SemiBold"/>
								<TextBlock x:Name="TxtSensorPitch" Text="Pitch: 0.0°" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Foreground="#0D47A1" FontWeight="SemiBold"/>
								<TextBlock x:Name="TxtSensorYaw" Text="Yaw: 0.0°" Grid.Row="1" Grid.Column="0" Foreground="#0D47A1" FontWeight="SemiBold"/>
								<TextBlock x:Name="TxtSensorTemp" Text="Temp: 0.0°C" Grid.Row="1" Grid.Column="1" Foreground="#0D47A1" FontWeight="SemiBold"/>
							</Grid>
						</Border>
						<TextBlock Text="MPU Sensor Data" Background="#F0F0F0" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Foreground="Black"/>
					</Grid>

				</StackPanel>
			</ScrollViewer>

			<Border Grid.Column="1" Background="Black" Margin="10,10,10,10" CornerRadius="5" ClipToBounds="True">
				<local:PlatformView3D x:Name="Visualizer" />
			</Border>

		</Grid>

		<Grid x:Name="ModalOverlay" Background="#90000000" IsVisible="False" ZIndex="100">
			<Border Background="White" Width="400" Height="300" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
				<StackPanel>
					<TextBlock Text="Connection Settings" FontWeight="Bold" FontSize="18" Foreground="Black" Margin="0,0,0,20"/>

					<RadioButton x:Name="RadioWifi" GroupName="ConnType" Content="Wi-Fi Connection" FontWeight="SemiBold" FontSize="14" Foreground="Black" Margin="0,0,0,5" IsChecked="True"/>
					<StackPanel Margin="25,0,0,15" IsEnabled="{Binding #RadioWifi.IsChecked}">
						<TextBox x:Name="TxtWifiUrl" Text="ws://192.168.4.1:81" Width="280" HorizontalAlignment="Left" Padding="5"/>
					</StackPanel>

					<RadioButton x:Name="RadioUsb" GroupName="ConnType" Content="USB Serial Connection" FontWeight="SemiBold" FontSize="14" Foreground="Black" Margin="0,0,0,5"/>
					<StackPanel Margin="25,0,0,15" IsEnabled="{Binding #RadioUsb.IsChecked}">
						<StackPanel Orientation="Horizontal">
							<ComboBox x:Name="ComboUsbPort" Width="190" Margin="0,0,10,0"/>
							<Button Content="Refresh" Width="80" Click="BtnRefreshPorts_Click" Background="#E0E0E0" Foreground="Black" HorizontalContentAlignment="Center"/>
						</StackPanel>
					</StackPanel>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Spacing="10">
						<Button Content="Cancel" Width="90" Height="32" Click="BtnModalCancel_Click" Background="#EEEEEE" Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
						<Button Content="Connect" Width="110" Height="32" Click="BtnModalConnect_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

	</Grid>
</Window>